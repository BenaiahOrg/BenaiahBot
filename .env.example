# CLI access token: @BotFather -> your bot -> Serverless -> CLI Access (form app<id>:<secret>)
TGCLOUD=

# Telegram user ids allowed to open the admin dashboard and use /stats (comma separated)
ADMIN_IDS=

# Optional: counselors to seed on first deploy (comma separated @usernames or numeric ids).
# You can also add them later from the admin dashboard.
COUNSELORS=
